APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azilapranz
DB_USERNAME=root
DB_PASSWORD=

# Legacy site database — read-only source for `php artisan azp:import-legacy`.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=bf_azilapranz_old
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# Absolute path to the legacy PHP site (used to copy userfiles/locations logos).
LEGACY_SITE_PATH=

# Google Places. The server key resolves and re-checks venue place IDs
# (`php artisan azp:places:backfill` / `azp:places:refresh`) — restrict it to
# the Places API. The browser key is exposed in the page and drives the
# Places UI Kit widget, so restrict it by HTTP referrer.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_UI_KIT=false

# Where azp:places:refresh emails newly closed / vanished venues. Leave empty
# to log them only.
AZP_ALERT_EMAIL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GA4 measurement ID. Production is G-GJFSCWE8HW (the default in config/azp.php).
# Leave this empty everywhere else — Consent Mode still sends cookieless pings
# while consent is denied, so an unset dev box pollutes the live property.
AZP_ANALYTICS_ID=

# Cookie consent gate. On (the default), the GA4 tag waits for the banner. Off,
# it loads and measures immediately and the banner, the footer withdrawal
# control and the cookie section of the privacy policy all disappear with it —
# which sets _ga with no prior consent and is not lawful for an EU audience.
AZP_COOKIE_CONSENT=true
